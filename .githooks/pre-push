#!/usr/bin/env sh
set -eu

zero_oid='0000000000000000000000000000000000000000'

sanitized_roots=$(git rev-list --max-parents=0 refs/heads/master 2>/dev/null || true)
root_count=$(printf '%s\n' "$sanitized_roots" | sed '/^$/d' | wc -l | tr -d ' ')

if [ "$root_count" != '1' ]; then
  echo "Push rejected: master must have exactly one sanitized repository root." >&2
  exit 1
fi

sanitized_root=$sanitized_roots

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  [ "$local_oid" != "$zero_oid" ] || continue

  if ! git cat-file -e "$local_oid^{commit}" 2>/dev/null ||
     ! git merge-base --is-ancestor "$sanitized_root" "$local_oid"; then
    echo "Push rejected: $local_ref contains history outside the sanitized repository root." >&2
    echo "Create a new branch from master and reapply only reviewed changes." >&2
    exit 1
  fi
done

exit 0
