#!/usr/bin/env sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoLogo -NoProfile -File scripts/check-secrets.ps1 -Staged
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/check-secrets.ps1 -Staged
fi

echo "Secret scan could not run because PowerShell is unavailable." >&2
exit 1
