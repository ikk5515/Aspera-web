# Deny every build-context file unless the Dockerfile explicitly needs its type.
**

!Dockerfile
!build.gradle
!settings.gradle
!gradle.lockfile
!gradlew

!gradle/
!gradle/**

!src/
!src/main/
!src/main/java/
!src/main/java/**/*.java
!src/main/resources/
!src/main/resources/**/*.properties
!src/main/resources/**/*.html
!src/main/resources/**/*.css
!src/main/resources/**/*.js
!src/main/resources/**/*.factories
!src/test/
!src/test/java/
!src/test/java/**/*.java

# Defense in depth if a newly allowed pattern becomes broader later.
**/.env
**/.env.*
**/application-local.*
**/application-secrets.*
**/.pgpass
**/pg_service.conf
**/*.pem
**/*.key
**/*.p8
**/*.pk8
**/*.pkcs8
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
