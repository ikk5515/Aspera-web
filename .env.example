# Copy this file to .env. The .env file is ignored by Git.
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SESSION_COOKIE_SECURE=true
FORWARD_HEADERS_STRATEGY=NATIVE

SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.internal:5432/aspera_db?sslmode=verify-full
SPRING_DATASOURCE_USERNAME=replace_with_database_username
SPRING_DATASOURCE_PASSWORD=replace_with_database_password
JPA_DDL_AUTO=validate

ASPERA_NODE_URL=https://node.example.internal:9092
ASPERA_NODE_USERNAME=replace_with_node_username
ASPERA_NODE_PASSWORD=replace_with_node_password
ASPERA_NODE_ALLOWED_ORIGINS=https://node.example.internal:9092

# Enable only for the first startup. Remove the bootstrap identity and password after use.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=replace_with_admin_username
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_random_password
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
